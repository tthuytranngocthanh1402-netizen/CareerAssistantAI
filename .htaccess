# Ép HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Không cho liệt kê thư mục / chặn file ẩn và file nội bộ
Options -Indexes
<FilesMatch "^\.(git|env|gitignore)|\.md$|\.log$">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteRule ^\.git - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

# Nén và cache
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
AddType audio/mp4 .m4a
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 10 minutes"
  ExpiresByType application/javascript "access plus 10 minutes"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 10 minutes"
  ExpiresByType text/javascript "access plus 10 minutes"
  ExpiresByType application/json "access plus 5 minutes"
</IfModule>
