# Chặn truy cập trực tiếp file cấu hình chứa API key
<FilesMatch "^config(\.sample)?\.php$">
  Require all denied
</FilesMatch>

# Chuyển tiêu đề Authorization cho PHP (dùng cho holland_export.php trên hosting dùng FastCGI)
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
