# Chặn truy cập trực tiếp file cấu hình chứa API key và các file hàm dùng chung (bắt đầu bằng _)
<FilesMatch "^(config(\.sample)?|_[A-Za-z0-9_]+)\.php$">
  Require all denied
</FilesMatch>

# Chuyển tiêu đề Authorization cho PHP (dùng cho holland_export.php trên hosting dùng FastCGI)
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
